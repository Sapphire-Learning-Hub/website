# 复制为 .env.local 并按需填写。所有变量都可缺省：缺少数据库时前台自动降级，dev/build 不受影响。

# MySQL 连接串（动态功能需要）。表结构在应用首次连接时自动创建。
DATABASE_URL=mysql://sapphire_app:change-me@localhost:3306/sapphire_hub

# 管理后台会话签名密钥（管理后台需要），用 `openssl rand -hex 32` 生成。
# 管理员账号存储在数据库中：首次访问 /admin 会引导交互式创建；
# 之后可用 `bun run create-admin <username>` 重置或新增账号。
SESSION_SECRET=

# 可选：GitHub Token，用于提升 GitHub API 限额（匿名额度 60 次/时，配合定时同步通常已足够）。
GITHUB_TOKEN=

# 可选：仓库列表自动同步间隔（分钟，最小 5，默认 60）。也可在后台「仓库」页手动同步。
REPO_SYNC_INTERVAL_MINUTES=60
